# API-Schlüssel von https://console.anthropic.com (Settings > API Keys)
ANTHROPIC_API_KEY=
# Passwort, mit dem man sich in der App anmeldet
APP_PASSWORD=
# Optional: anderes Modell oder mehr Sorgfalt (low, medium, high)
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# Optional, nur lokal: ohne API-Schlüssel mit erfundenen Antworten testen
# MOCK_CLAUDE=1
